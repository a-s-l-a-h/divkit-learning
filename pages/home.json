{
    "card": {
        "log_id": "home_screen",
        "states": [
            {
                "state_id": 0,
                "div": {
                    "type": "container",
                    "orientation": "vertical",
                    "width": {
                        "type": "match_parent"
                    },
                    "height": {
                        "type": "match_parent"
                    },
                    "paddings": {
                        "top": 40,
                        "bottom": 40,
                        "left": 20,
                        "right": 20
                    },
                    "background": [
                        {
                            "type": "solid",
                            "color": "#f5f5f5"
                        }
                    ],
                    "items": [
                        {
                            "type": "text",
                            "text": "🏠 Home Page",
                            "font_size": 36,
                            "font_weight": "bold",
                            "text_color": "#333333",
                            "margins": {
                                "bottom": 10
                            }
                        },
                        {
                            "type": "text",
                            "text": "Welcome back, @{user_name}!",
                            "font_size": 18,
                            "text_color": "#666666",
                            "margins": {
                                "bottom": 10
                            }
                        },
                        {
                            "type": "text",
                            "text": "Status: @{membership_status}",
                            "font_size": 16,
                            "text_color": "#28a745",
                            "font_weight": "medium",
                            "margins": {
                                "bottom": 40
                            }
                        },
                        {
                            "type": "container",
                            "orientation": "vertical",
                            "items": [
                                {
                                    "type": "text",
                                    "text": "View Profile",
                                    "font_size": 18,
                                    "font_weight": "medium",
                                    "text_color": "#ffffff",
                                    "text_alignment_horizontal": "center",
                                    "background": [
                                        {
                                            "type": "solid",
                                            "color": "#007bff"
                                        }
                                    ],
                                    "border": {
                                        "corner_radius": 8
                                    },
                                    "paddings": {
                                        "top": 15,
                                        "bottom": 15,
                                        "left": 30,
                                        "right": 30
                                    },
                                    "margins": {
                                        "bottom": 15
                                    },
                                    "actions": [
                                        {
                                            "log_id": "nav_profile",
                                            "url": "app://navigate?page=profile"
                                        }
                                    ]
                                },
                                {
                                    "type": "text",
                                    "text": "Settings",
                                    "font_size": 18,
                                    "font_weight": "medium",
                                    "text_color": "#ffffff",
                                    "text_alignment_horizontal": "center",
                                    "background": [
                                        {
                                            "type": "solid",
                                            "color": "#28a745"
                                        }
                                    ],
                                    "border": {
                                        "corner_radius": 8
                                    },
                                    "paddings": {
                                        "top": 15,
                                        "bottom": 15,
                                        "left": 30,
                                        "right": 30
                                    },
                                    "actions": [
                                        {
                                            "log_id": "nav_settings",
                                            "url": "app://navigate?page=settings"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            }
        ]
    }
}